<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="benefits">
      {% for block in section.blocks %}
        <div class="benefit" {{ block.shopify_attributes }}>
          <strong>{{ block.settings.title }}</strong>
          <span>{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    </div>
    <div class="hero-cta">
      <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% if section.settings.price != blank %}<span class="price">{{ section.settings.price }}</span>{% endif %}
    </div>
  </div>
  <div class="hero-media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '700,1000,1400', sizes: '50vw', alt: section.settings.heading }}
    {% else %}
      {{ 'hero-reference.jpg' | asset_url | image_tag: loading: 'eager', alt: 'Image temporaire à remplacer' }}
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"Hero premium","settings":[{"type":"text","id":"eyebrow","label":"Petit titre","default":"INTELLIGENTE. ÉLÉGANTE. SANS EFFORT."},{"type":"text","id":"heading","label":"Titre","default":"La poubelle intelligente qui simplifie votre quotidien"},{"type":"textarea","id":"text","label":"Description","default":"Un design premium, une utilisation automatique et des recharges pratiques. Une solution pensée pour un intérieur moderne."},{"type":"image_picker","id":"image","label":"Image principale"},{"type":"text","id":"button_label","label":"Texte du bouton","default":"Découvrir la collection"},{"type":"url","id":"button_link","label":"Lien du bouton"},{"type":"text","id":"price","label":"Prix affiché","default":"À partir de 79,99 €"}],"blocks":[{"type":"benefit","name":"Avantage","settings":[{"type":"text","id":"title","label":"Titre","default":"Ouverture automatique"},{"type":"text","id":"text","label":"Sous-texte","default":"Pratique au quotidien"}]}],"presets":[{"name":"Hero premium","blocks":[{"type":"benefit","settings":{"title":"Ouverture automatique","text":"Sans contact au quotidien"}},{"type":"benefit","settings":{"title":"Design premium","text":"Pensée pour votre intérieur"}},{"type":"benefit","settings":{"title":"Recharges pratiques","text":"Disponibles en plusieurs formats"}}]}]}
{% endschema %}