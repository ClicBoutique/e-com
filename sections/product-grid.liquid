<section class="products">
  <div class="page-width">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <div class="product-grid">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          <article class="card">
            <a class="card-image" href="{{ product.url }}">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
              {% endif %}
            </a>
            <div class="card-body">
              <h3 class="card-title">{{ product.title }}</h3>
              <div class="card-price">{{ product.price | money }}</div>
              <a class="btn" href="{{ product.url }}">Voir le produit</a>
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <article class="card">
            <div class="card-image">{{ 'hero-reference.jpg' | asset_url | image_tag: loading: 'lazy', alt: 'Image temporaire' }}</div>
            <div class="card-body">
              <h3 class="card-title">Votre produit {{ i }}</h3>
              <div class="card-price">À configurer</div>
              <span class="btn">Ajouter votre produit</span>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Collection produits","settings":[{"type":"text","id":"heading","label":"Titre","default":"Découvrez la collection"},{"type":"text","id":"text","label":"Sous-titre","default":"Une sélection pensée autour de votre quotidien."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Nombre de produits","min":3,"max":6,"step":1,"default":3}],"presets":[{"name":"Collection produits"}]}
{% endschema %}