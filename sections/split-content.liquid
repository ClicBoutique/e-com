<section class="split {% if section.settings.dark %}dark{% endif %}">
  <div class="split-media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700,1000,1400', sizes: '50vw', alt: section.settings.heading }}
    {% else %}
      {{ 'hero-reference.jpg' | asset_url | image_tag: loading: 'lazy', alt: 'Image temporaire à remplacer' }}
    {% endif %}
  </div>
  <div class="split-copy">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.link_text != blank %}<a class="text-link" href="{{ section.settings.link_url }}">{{ section.settings.link_text }} →</a>{% endif %}
  </div>
</section>
{% schema %}
{"name":"Bloc image + texte","settings":[{"type":"checkbox","id":"dark","label":"Fond sombre","default":false},{"type":"text","id":"eyebrow","label":"Petit titre","default":"PENSÉ POUR VOTRE QUOTIDIEN"},{"type":"text","id":"heading","label":"Titre","default":"Un geste de moins, chaque jour."},{"type":"textarea","id":"text","label":"Texte","default":"Une expérience simple et élégante, conçue pour s'intégrer naturellement dans votre intérieur."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"link_text","label":"Texte du lien","default":"Découvrir en détail"},{"type":"url","id":"link_url","label":"Lien"}],"presets":[{"name":"Bloc image + texte"}]}
{% endschema %}